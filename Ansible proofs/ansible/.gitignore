# --- Secrets: never commit these (the repo is PUBLIC) ---
# Vault password files (the real one lives outside the repo: ~/.ansible/nel_vault_pass)
.vault_pass*
*vault_pass*
*.vault_password
# Private keys and certificates
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
!*.pub
# Unencrypted copies of vault files made while editing
*.decrypted
*.plain.yml

# --- Lab / tooling artefacts ---
# Collections are installed from requirements.yml, not committed
collections/
# Vagrant machine state
lab/.vagrant/
# Ansible runtime files
*.retry
.ansible/
__pycache__/
*.pyc
